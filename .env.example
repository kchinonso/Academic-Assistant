# Google Service Account JSON path
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# Comma-separated list of Google Drive Root Folder IDs to index
ROOT_FOLDER_IDS=your_drive_folder_id_1,your_drive_folder_id_2

# File and Indexing Settings
MAX_FILE_MB=90
PAGE_SIZE=40
INDEX_REFRESH_MINUTES=10
INDEX_FILE=./data/search-index.json

# Bot Identity and Community Info
BOT_NAME=Academic Materials Assistant
COMMUNITY_NAME=NextGen Hub
COMMUNITY_LINK=https://chat.whatsapp.com/your-group-invite

# Admin / Owner Configuration
OWNER_NUMBER=2348000000000
OWNER_CHAT_ID=
BROADCAST_DELAY_MS=1500

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_STUDY_MODEL=gemini-2.5-flash
AI_CANDIDATE_LIMIT=12
AI_STUDY_FILE_LIMIT=2
AI_SOURCE_FILE_MAX_MB=18
